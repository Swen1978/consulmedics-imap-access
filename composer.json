{
    "name": "consulmedics/imap-access",
    "description": "Access certain folders in an IMAP mailbox. Developed for specific needs in Consulmedics.*",
    "license": "MIT",
    "keywords": [
        "edwink",
        "consulmedics",
        "imap",
        "mailbox-access"
    ],
    "type": "library",
    "authors": [
        {
            "name": "Bernhard Hörmann",
            "email": "hoermann.b@gmail.com"
        },
        {
            "name": "Edwin Krause",
            "email": "edwin@kitc.eu"
        }
    ],
    "require": {
        "php": "^8.1",
        "laravel/framework": "^10.0|^11.0|^12.0",
        "filament/forms": "^3.0",
        "filament/tables": "^3.0",
        "livewire/livewire": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "Consulmedics\\ImapAccess\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Consulmedics\\ImapAccess\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Consulmedics\\ImapAccess\\Providers\\ImapAccessServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": [
            "@php vendor/bin/phpunit"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
